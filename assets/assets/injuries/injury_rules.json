      "title": "What Exercises to Avoid with Shoulder Pain",
      "publisher": "Baptist Health (blog, Orthopedic Care)",
      "url": "https://www.baptisthealth.com/blog/orthopedic-care/what-exercises-to-avoid-with-shoulder-pain",
      "usedFor": "Shoulder: avoid overhead presses, bench dips, pulldowns (especially behind the neck), upright rows, deep push-ups and heavy lateral raises; stop on sharp pain; see an orthopedic provider for a rotator cuff injury."
    },
    {
      "id": "hss-knee",
      "title": "3 Ways to Work Around Knee Pain",
      "publisher": "Hospital for Special Surgery (newsroom)",
      "url": "https://news.hss.edu/3-ways-to-work-around-knee-pain/",
      "usedFor": "Knee: leave out running and jumping first; squats and lunges when the pain is at the front of the knee; prefer low-impact work."
    },
    {
      "id": "uf-back",
      "title": "Low Back Pain - Acute",
      "publisher": "UF Health",
      "url": "https://ufhealth.org/conditions-and-treatments/low-back-pain-acute",
      "usedFor": "Lower back: avoid heavy lifting and twisting for the first weeks; stay active; the list of warning signs that mean seeing a doctor promptly."
    },
    {
      "id": "racgp-back",
      "title": "Exercise for acute lower back pain (HANDI)",
      "publisher": "The Royal Australian College of General Practitioners",
      "url": "https://www.racgp.org.au/clinical-resources/clinical-guidelines/handi/handi-interventions/exercise/exercise-for-acute-lower-back-pain",
      "usedFor": "Lower back: avoid heavy lifting, bending and twisting until the pain improves. Read as a summary only."
    }
