  {
    "id": "classic-5x5",
    "name": "Classic 5x5",
    "summary": "Alternating A/B barbell strength workouts, three days a week.",
    "description": "The tried-and-tested linear strength plan: three compound lifts per session, five sets of five. Alternate A and B workouts and add the smallest plate increment whenever you complete all 25 reps. If you stall three sessions in a row, drop the weight by 10% and build back up.",
    "level": "beginner",
    "daysPerWeek": 3,
    "goal": "Strength",
    "equipment": "Full gym",
    "trainings": [
      {
        "name": "Workout A",
        "notes": "Squat, bench, row.",
        "exercises": [
          {
            "exerciseId": "Barbell_Full_Squat",
            "sets": 5,
            "reps": 5,
            "warmupSets": 2,
            "restSec": 180,
            "notes": "Add 2.5 kg when all five sets are done."
          },
          {
            "exerciseId": "Barbell_Bench_Press_-_Medium_Grip",
            "sets": 5,
            "reps": 5,
            "warmupSets": 2,
            "restSec": 180
          },
          {
            "exerciseId": "Bent_Over_Barbell_Row",
            "sets": 5,
            "reps": 5,
            "warmupSets": 1,
            "restSec": 150,
            "notes": "Row to the lower ribs, flat back."
          }
        ]
      },
      {
        "name": "Workout B",
        "notes": "Squat, press, deadlift.",
        "exercises": [
          {
            "exerciseId": "Barbell_Full_Squat",
            "sets": 5,
            "reps": 5,
            "warmupSets": 2,
            "restSec": 180
          },
          {
            "exerciseId": "Standing_Military_Press",
            "sets": 5,
            "reps": 5,
            "warmupSets": 2,
            "restSec": 150
          },
          {
            "exerciseId": "Barbell_Deadlift",
            "sets": 1,
            "reps": 5,
            "warmupSets": 2,
            "restSec": 240,
            "notes": "One heavy set of five. Reset each rep."
          }
        ]
      }
    ]
